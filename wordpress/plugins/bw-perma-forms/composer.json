{
	"name": "blickwert/bw-perma-forms",
	"description": "Forms of the PERMA Mind Academy (WordPress plugin)",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"brain/monkey": "^2.6"
	},
	"autoload-dev": {
		"psr-4": {
			"BW\\PermaForms\\": "free/src/",
			"BW\\PermaForms\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find free -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
	},
	"config": {
		"sort-packages": true
	}
}
